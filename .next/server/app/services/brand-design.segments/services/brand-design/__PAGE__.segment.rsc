ign"}],["$","p",null,{"children":"Orgits creates brand identities that communicate your unique value proposition at a glance. We design logos, visual systems, typography, color palettes and brand guidelines that ensure consistent, recognizable expression across every touchpoint."}],["$","ul",null,{"className":"list-item clearfix","children":[["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Brand strategy & positioning workshops"}]}]]}],["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Logo design & variations (primary, secondary, icon)"}]}]]}],["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Typography system & color palette"}]}]]}],["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Iconography, illustration & photography style"}]}]]}],["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Brand guidelines (digital & print)"}]}]]}],["$","li",null,{"children":[["$","div",null,{"className":"icon","children":["$","span",null,{"className":"icon-check"}]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Voice, tone & messaging framework"}]}]]}]]}]]}]]}],["$","div",null,{"className":"service-details__text","children":[["$","div",null,{"className":"title","children":[["$","h3",null,{"children":"Brand That Builds Trust Before the First Conversation"}],["$","p",null,{"children":"We translate your mission, values and differentiation into a visual and verbal language that resonates with your target audience and scales across channels."}]]}],["$","div",null,{"className":"text","children":["$","p",null,{"children":"Brand engagements begin with discovery—stakeholder interviews, competitor visual audits, audience perception surveys and brand attribute mapping. We define brand personality, promise and positioning statements. Logo exploration covers wordmarks, lettermarks, combination marks and icon systems with rationale for each direction. Visual system extends to color psychology, typographic hierarchy, grid systems and icon families. Guidelines document usage rules, clear space, minimum sizing, color codes (Pantone, CMYK, RGB, HEX), typography scales and do/don't examples. Voice and tone framework covers writing principles, vocabulary, channel-specific adaptations and example copy. Deliverables include Figma/Sketch source files, asset exports (SVG, PNG, WebP), brand guideline PDF and design token JSON for digital implementation."}]}]]}],"$L4","$L5"]}]}],"$L6"]}]}]}]}]],["$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"},{"rsc":"$L10","isPartial":"$@11","staleTime":"$a","varyParams":"$f"},{"rsc":"$L12","isPartial":"$@13","staleTime":"$a","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@14","rootVaryParams":null,"needsRuntimeRequest":"$@15"}
